root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = tab
tab_width = 4
max_line_length = 100

[*.{yml,yaml,md,toml}]
indent_style = space
indent_size = 2

# Verbatim license texts
[{LICENSE*,LICENSES/**}]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
tab_width = unset
max_line_length = unset
